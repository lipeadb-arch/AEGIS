<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- FluentAssertions fixado em 6.12.0: última linha sob Apache 2.0. A v8+ passou a licença
         comercial (Xceed) — pino aqui para não introduzir dívida de licença no projeto. -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- [AEGIS-AUD-010] Microsoft.Extensions.{Configuration,DependencyInjection,Hosting} eram
         PackageReferences explícitas (fail-open + host do AUD-052). A referência ao shared framework
         Microsoft.AspNetCore.App (adicionada abaixo para os testes de atributo de autorização) já as
         fornece; mantê-las explícitas dispara NU1510 (pacote redundante). Removidas — o framework as
         provê na mesma linha 10.0.x. Os tipos usados nos testes de fail-open/host seguem disponíveis. -->
    <!-- SQLite in-memory: banco relacional real e efêmero para exercitar o FrameworkSeeder ponta a
         ponta (EnsureCreated + SaveChanges) sem PostgreSQL. Alinhado ao EF Core 10. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- 2.1.11 é o PISO exigido por EF Core Sqlite 10.0.10 (que depende de SQLitePCLRaw.core 2.1.11);
         manter 2.1.10 dispara NU1605. Fixado no piso de propósito: o SQLitePCLRaw tem linha de versão
         própria (já existem 2.1.12 e 3.0.x) e não deve ser elevado só por ser mais recente. Escopo de
         teste apenas — o runtime de produção é PostgreSQL, nunca SQLite. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
  </ItemGroup>

  <!-- Auditoria NuGet: o advisory GHSA-2m69-gcr7-jv3q marca toda versão publicada do e_sqlite3 nativo
       (sem build corrigida upstream). Suprimido de forma explícita e rastreável — NÃO um <NoWarn> cego:
       o SQLite existe só no ambiente de TESTE (produção é PostgreSQL) e roda apenas com ':memory:' sobre
       dados que nós mesmos geramos, fora de qualquer superfície de ataque. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- [AEGIS-AUD-010] O contrato de AUTORIZAÇÃO das superfícies de identidade é parte da correção
       (rota global exige PlatformAdmin; concessão exige TenantAdmin). Sem harness de integração HTTP no
       projeto, a garantia é verificada por reflexão sobre os atributos dos controllers — o que exige
       referenciar o projeto da API e o shared framework do ASP.NET Core para resolver AuthorizeAttribute. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AegisScore.Infrastructure\AegisScore.Infrastructure.csproj" />
    <!-- AEGIS-AUD-052: o migrator é o único autorizado a preparar o banco, então o parsing de
         argumentos e o contrato de códigos de saída precisam de cobertura própria. -->
    <ProjectReference Include="..\..\src\AegisScore.DbMigrator\AegisScore.DbMigrator.csproj" />
    <!-- [AEGIS-AUD-010] Referência ao projeto da API para os testes de atributo de autorização das
         superfícies de identidade (PlatformIdentitiesController / UsersController). -->
    <ProjectReference Include="..\..\src\AegisScore.Api\AegisScore.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O AuditorPersonality.json de PRODUÇÃO, linkado (não copiado) para o output do teste. É editável
         sem recompilar, então um erro de digitação nele só apareceria em runtime, degradando a persona
         em silêncio — o AuditorPersonaTests carrega ESTE arquivo para que o CI pegue a quebra. -->
    <Content Include="..\..\src\AegisScore.Api\Data\AuditorPersonality.json" Link="Data\AuditorPersonality.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
