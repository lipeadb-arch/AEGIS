<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Habilita o Secret Manager (dotnet user-secrets) para segredos de dev — ex.: Ai:ApiKey.
         O WebApplication.CreateBuilder carrega esses segredos automaticamente em Development. -->
    <UserSecretsId>d8f3a1c6-4e2b-47a9-9b7d-2c5e8f0a1b34</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AegisScore.Infrastructure\AegisScore.Infrastructure.csproj" />
    <ProjectReference Include="..\AegisScore.Connectors.Microsoft\AegisScore.Connectors.Microsoft.csproj" />
    <ProjectReference Include="..\AegisScore.Connectors.Google\AegisScore.Connectors.Google.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Testes focados acessam o helper interno DocumentAnalysisWorker.DedupeCandidates sem torná-lo público. -->
    <InternalsVisibleTo Include="AegisScore.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Catálogos GRC de posse do projeto da API (Data/). Copiados para o output:
         o catálogo alimenta o FrameworkSeeder (ContentRootPath/Data/, ver Program.cs) e
         as regras serão carregadas pelo motor de avaliação no startup da próxima fase. -->
    <Content Update="Data\nist_csf_2_0_catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Metodologia AUTORAL do AEGIS (maturidade + pesos + subcategorias não automatizadas), SEPARADA do
         catálogo oficial NIST para nunca apresentar conteúdo autoral como conteúdo NIST. -->
    <Content Update="Data\aegis_methodology.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\aegis_assessment_rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- [AEGIS-MVP-LANGUAGE-01] Camada de apresentação AUTORAL do AEGIS (linguagem clara provider-neutral,
         pt-BR) por subcategoria. SEPARADA do catálogo oficial NIST — não é tradução oficial. Lida uma vez, na
         primeira utilização, pelo ControlLanguageCatalog (singleton) a partir do Data/ ao lado do binário e
         usada pela query do dashboard para entregar título/resumo/impacto/ação ao frontend. -->
    <Content Update="Data\aegis_control_language.pt-BR.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- [AEGIS-MVP-LANGUAGE-02] Camada de apresentação AUTORAL do AEGIS para EXPOSIÇÕES de configuração
         (linguagem clara provider-neutral, pt-BR). SEPARADA do conteúdo dinâmico da fonte — não é tradução
         oficial. Lida na primeira utilização pelo ExposureLanguageCatalog (singleton). -->
    <Content Update="Data\aegis_exposure_language.pt-BR.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Personalidade do Auditor Virtual: lida no startup pelo AuditorPersonaProvider (singleton) a partir
         do diretório do binário. Ajustar o TOM do motor não exige recompilar — só reiniciar. -->
    <Content Update="Data\AuditorPersonality.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
