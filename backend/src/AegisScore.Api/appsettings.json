{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AegisScore": ""
  },
  "Jwt": {
    "Issuer": "aegis-score",
    "Audience": "aegis-score",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7
  },
  "Ai": {
    "Provider": "Anthropic",
    "ApiKey": "",
    "Model": "claude-opus-4-8",
    "BaseUrl": "https://api.anthropic.com/v1/messages",
    "Mode": "Simulated",
    "MaxOutputTokens": 4096,
    "FreeTier": {
      "AllowedTenantSlugs": [],
      "MaxDocumentChars": 24000,
      "MaxCallsPerAnalysis": 8,
      "MaxQuestionsPerMinute": 10
    }
  },
  "Scoring": {
    "DefaultSignalFreshnessHours": 72
  },
  "DataProtection": {
    "PersistenceProvider": "DbContext",
    "RequirePersistence": false,
    "RequireKeyEncryption": false
  }
}
