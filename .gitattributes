# Normaliza fim de linha: LF no repositório, nativo no checkout de cada SO.
# Evita o "arquivo inteiro mudou" ao trabalhar entre máquinas diferentes.
* text=auto

# Scripts sempre LF
*.sh   text eol=lf
# [AEGIS-KNIGHT-COVERAGE-02] O adaptador de coleta do Teams é um recurso EMBUTIDO que roda no Linux do
# contêiner: o conteúdo precisa ser o MESMO em qualquer máquina que gere a imagem.
*.ps1  text eol=lf

# Binários — não mexer em fim de linha
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
